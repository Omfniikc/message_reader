# --- Telegram user account (my.telegram.org -> API development tools) ---
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# --- Bot (from @BotFather) ---
BOT_TOKEN=123456:ABC-DEF_your_bot_token

# --- Owner (your Telegram user id, e.g. from @userinfobot) ---
OWNER_ID=111222333

# --- Proxy (optional, used by Telethon AND Bot API when direct access is blocked) ---
# http://login:password@host:port or socks5://host:1080
# PROXY=http://login:password@host:port

# --- LLM ---
# openai | anthropic
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
# provider-specific model name
LLM_MODEL=gpt-4o-mini
# Optional: custom endpoint for aggregators speaking the OpenAI/Anthropic
# protocol (e.g. https://tokify.sale/v1). Empty = official endpoint.
# LLM_BASE_URL=https://tokify.sale/v1

# --- Limits ---
# default / max messages to fetch per summary request
DEFAULT_MESSAGE_LIMIT=100
MAX_MESSAGE_LIMIT=500
# max characters of transcript sent to the LLM (oldest messages are dropped first)
MAX_TRANSCRIPT_CHARS=60000

# --- Session file name (without extension) ---
SESSION_NAME=message_reader
